# Dependencies & build output
node_modules/
build/
dist/
coverage/

# Generated frontend embedded into AegisROM.exe (built by `npm run release:win`)
cmd/aegis-gui/webdist/*
!cmd/aegis-gui/webdist/.gitkeep

# Generated Setup.exe payload (built by `npm run release:win`)
cmd/aegis-setup/payload/AegisROM.exe.gz

# Release binaries: published via GitHub Releases, never committed
public/downloads/*
!public/downloads/aegis-scanner.go
!public/downloads/version.json
*.exe
*.zip

# Local runtime data of `npm run dev:api` (library DB, builds, caches, API token)
.aegis-data/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Logs, env, temp
*.log
.env*
*.tmp
WebViewProfile*/
