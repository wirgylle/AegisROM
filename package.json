{
  "name": "aegisrom",
  "private": true,
  "version": "0.6.2",
  "type": "module",
  "scripts": {
    "predev": "node scripts/fetch-emulatorjs.mjs",
    "dev": "vite",
    "dev:api": "go run ./cmd/aegis-server -data .aegis-data",
    "start": "go run ./cmd/aegis-server",
    "prebuild": "node scripts/fetch-emulatorjs.mjs",
    "build": "vite build",
    "release:win": "node scripts/release-win.mjs",
    "release:mac": "bash scripts/release-mac.sh",
    "preview": "vite preview",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "tsc --noEmit",
    "test": "node --test --experimental-strip-types --no-warnings=ExperimentalWarning \"src/**/*.test.ts\"",
    "fetch:emulatorjs": "node scripts/fetch-emulatorjs.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "lucide-react": "^0.546.0",
    "qrcode-generator": "2.0.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  }
}
